{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nude",
  "version": "0.1.0",
  "identifier": "com.nude.app",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nude",
        "width": 1240,
        "height": 790,
        "minWidth": 800,
        "minHeight": 500,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Observabilidad y checkpoints para agentes de IA en repos Git locales",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
